# Security: never run dependency lifecycle scripts during install.
# This dependency tree is pure JS (no native builds), so no package
# legitimately needs a pre/post/install hook — blocking them closes the
# npm-supply-chain RAT vector (e.g. the axios postinstall incident) at
# zero cost. npm strips this file from the published tarball, so it only
# governs local installs of this package's own deps, not consumers.
ignore-scripts=true
